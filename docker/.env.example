# --- Universal ---
PUBLIC_URL=https://workbench.example.com     # the domain you'll set up in NPM
EXPOSE_HOSTNAME=workbench.example.com        # used in MLflow's allowed hosts/CORS
HOST_PROJECT_DIR=/home/<vm-user>/AI_Experiment_Workbench/docker   # VM path, used for DockerSpawner bind mounts

# --- Postgres ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# --- MinIO ---
MINIO_USER=minio_user
MINIO_PASSWORD=minio_pwd
MINIO_BUCKET=mlflow

# --- MLflow ---
MLFLOW_FLASK_SECRET_KEY=changeme      # openssl rand -base64 32
EXPOSE_HOSTNAME=localhost

# --- Keycloak ---
KEYCLOAK_VERSION=26.4
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_JHUB_CLIENT_SECRET=changeme        # openssl rand -hex 16  (was: randAlphaNum 32)
JHUB_URL=http://localhost:8000        # where JupyterHub will be reachable

# --- JupyterHub ---
JUPYTERHUB_CRYPT_KEY=changeme
NOTEBOOK_IMAGE=registry.git.nrw/rwth-acs/public/ai-workbench/notebook:latest
MLFLOW_ADMIN_USERNAME=admin
MLFLOW_ADMIN_PASSWORD=admin420noscope

# --- Flower ---
COMPOSE_PROFILES=flower           # start Flower with a plain "docker compose up"; remove to disable
MLFLOW_FED_USERNAME=mlflowfed
MLFLOW_FED_PASSWORD=mlflowfed123456
FEDERATED_EXPERIMENT_ID=1         # set from flower-fed-init output, see below